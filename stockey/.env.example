# Core paths
BASE_DIR=
HTTP_CACHE=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SQL_TO_DF_RETRIES=2
SQL_TO_DF_RETRY_SLEEP_SECONDS=1.0
SQL_TO_DF_STATEMENT_TIMEOUT_MS=0
SQL_TO_DF_CHUNK_SIZE=0
DB_OPERATION_ATTEMPTS=3
DB_POOL_RECYCLE_SECONDS=300
DB_RETRY_TELEMETRY_FILE=logs/fallback/db_retry_events.jsonl
LOCAL_FALLBACK_TELEMETRY_FILE=logs/fallback/local_fallback_events.jsonl

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_OPERATION_ATTEMPTS=3
REDIS_RETRY_SLEEP_SECONDS=1.0
REDIS_RECONNECT_COOLDOWN_SECONDS=30.0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_FAIL_SOFT=true

# Exchange rate limiting (utils/exchange_rate_limiter.py) -- cross-process floors, not
# per-script, so raising either here raises it for every collector against that source
# at once. NSE: do not lower without confirming NSE's current tolerance first (Akamai
# WAF blocked fast on request rate, 2026-08-09/10 incident). BSE: conservative default,
# no incident yet -- keep it that way.
NSE_MIN_REQUEST_INTERVAL_SECONDS=10.0
BSE_MIN_REQUEST_INTERVAL_SECONDS=10.0

# fundamentals/collectors/bse_announcements.py -- how far back each daily L3 detection
# run looks for new BSE filings. Small on purpose: this is a daily job, not a backfill;
# a wide window just means re-scanning (harmlessly, upsert-keyed) filings already seen.
BSE_ANNOUNCEMENTS_LOOKBACK_DAYS=7

# fundamentals/collectors/bse_announcements.py -- how many companies the 3yr
# auditor-change/RPT historical backfill processes per daily run (re-audit
# 2026-08-18: this backfill used to be manual-only and never actually ran, 0/43
# target companies backfilled to date). See BACKFILL_DAILY_LIMIT's own comment.
BSE_AUDITOR_RPT_BACKFILL_DAILY_LIMIT=5

# fundamentals/collectors/nse_pit.py -- same rationale as BSE_ANNOUNCEMENTS_LOOKBACK_DAYS.
NSE_PIT_LOOKBACK_DAYS=7

# fundamentals/collectors/rating_agencies.py -- batch cap + wall-clock budget for one
# rating-enrichment run (re-audit 2026-08-18: previously had neither, so every run
# processed the ENTIRE pending backlog -- the eligible set grows monotonically at a
# >=10s/domain rate-gate floor, same runaway-runtime risk already fixed elsewhere in
# this pipeline). See DEFAULT_BATCH_LIMIT/MAX_RUNTIME_SECONDS' own comment.
RATING_ENRICHMENT_DEFAULT_BATCH_LIMIT=200
RATING_ENRICHMENT_MAX_RUNTIME_SECONDS=10800

# data/bseindia/bhavcopy.py -- BSE-only-company price coverage (2026-08-15,
# fundamentals screener gap fix: 43 active L1-universe companies have no NSE
# listing at all). Only fetchable back to 2024-01-01 regardless of this setting
# (BSE's own switch to the UDiFF bhavcopy format/naming -- see module docstring).
BSE_BHAVCOPY_DOWNLOAD_LOOKBACK_DAYS=365
# Caps how many missing dates one run fetches (re-audit 2026-08-18: with only 3
# days of history present against the 365-day lookback above, an uncapped run
# would cost ~45 minutes inside complete_data.sh at the 10s rate-gate floor). See
# BSE_BHAVCOPY_MAX_DATES_PER_RUN's own comment in bhavcopy.py.
BSE_BHAVCOPY_MAX_DATES_PER_RUN=60

# Caps how long one run of the RBI reference-FX-rate yearly-chunk backfill can take
# (re-audit 2026-08-19: a resume point far behind, e.g. after an extended CDP/site
# outage, would otherwise walk every intervening yearly chunk in a single cron
# invocation). See RBI_CURRENCY_RATES_MAX_RUNTIME_SECONDS's own comment in
# download_currency_rates.py.
RBI_CURRENCY_RATES_MAX_RUNTIME_SECONDS=1200

# NSE historical lookbacks
NSE_BHAVCOPY_DOWNLOAD_LOOKBACK_DAYS=365
NSE_BHAVCOPY_PARSE_LOOKBACK_DAYS=365
NSE_INDICES_DOWNLOAD_LOOKBACK_DAYS=365
NSE_INDICES_PARSE_LOOKBACK_DAYS=365
# Empty (0-byte) NSE index downloads are transient: retry this many extra times in-run, then keep
# retrying across the next N daily runs before giving up (so a transient empty never becomes a permanent gap).
NSE_INDICES_EMPTY_DOWNLOAD_RETRIES=2
NSE_INDICES_EMPTY_RETRY_WINDOW_DAYS=4
NSE_LEGACY_RETENTION_DAYS=365
NSE_LEGACY_ARCHIVE_PREFIX=archives/nseindia
TRACE_RETENTION_DAYS=90
INTRADAY_RETENTION_DAYS=45
HOT_TABLE_ARCHIVE_PREFIX=archives/hot_tables
RBI_FBIL_GSEC_LOOKBACK_DAYS=365

# Codex CLI (used by utils/ocr and utils/transcribe as an optional OCR/transcription
# provider -- NOT part of the data pipeline; stockey's collectors make zero LLM calls,
# see docs/DATA_INVENTORY.md)
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=gpt-5.4-mini
CODEX_CLI_OCR_MODEL=gpt-5.4-mini
CODEX_CLI_TIMEOUT_SECONDS=300
POPPLER_PATH=

# utils/ocr and utils/transcribe standalone utilities (OpenAI/Gemini providers)
OPENAI_API_KEY=
GEMINI_KEY=

# utils/ocr/llm_ocr.py's local provider (GLM-OCR, self-hosted via transformers, not
# Ollama -- see the module docstring comment on ocr_page_with_local for why) --
# fundamentals/collectors/ocr_pipeline.py's OCR step (docs/FUNDAMENTAL_SCREENER_PRD.md
# sec 6). This IS an LLM call, unlike the rest of stockey's pure-TA collectors -- see
# docs/FUNDAMENTAL_SCREENER_PRD.md sec 1 for the fundamentals/systrader boundary.
GLM_OCR_MODEL=zai-org/GLM-OCR
GLM_OCR_MAX_NEW_TOKENS=4096
# Downscale rendered pages to this max dimension before OCR -- ~3x faster on CPU with
# no observed quality loss (confirmed live 2026-08-10 against a real ICRA rationale
# PDF page); vision-token count, not text length, dominates CPU inference time.
GLM_OCR_MAX_IMAGE_DIMENSION=1280

# fundamentals/collectors/structured_extraction.py's stage-2 model (OCR text -> typed
# fields, per docs/FUNDAMENTAL_SCREENER_PRD.md sec 6) -- verified live 2026-08-11
# against 3 real OCR'd documents before committing to this model, see the module
# docstring for what that testing found.
STRUCTURED_EXTRACTION_MODEL=gpt-5.4-mini

# fundamentals/screens/llm_triage.py -- L3's judgment-based alert path (docs/
# FUNDAMENTAL_SCREENER_PRD.md sec 3.2), alongside fundamentals/screens/l3_triggers.py's
# rule-based path.
LLM_TRIAGE_MODEL=gpt-5.4-mini

# fundamentals/screens/watch_summary.py -- company-level watchlist narrative + suggested
# watch duration synthesis (fundamental screener step 11, agreed 2026-08-11).
WATCH_SUMMARY_MODEL=gpt-5.4-mini

# fundamentals/screens/l4_thesis_draft.py -- daily LLM-drafted CANDIDATE L4 theses
# (prediction_text/target_date/invalidation_criteria/confidence_score) surfaced in the
# watchlist digest email for human review (step 11.5, agreed 2026-08-15). Never writes
# fundamentals_l4_thesis itself -- see that module's docstring guardrail.
L4_THESIS_DRAFT_MODEL=gpt-5.4-mini

# fundamentals/screens/investor_classification.py -- 3-tier investor recognition
# classification for capital-raise events (fundamental screener step 14, agreed
# 2026-08-12). Uses the model's own training knowledge, not live web search.
INVESTOR_CLASSIFICATION_MODEL=gpt-5.4-mini

# fundamentals/collectors/ocr_pipeline.py -- wall-clock budget (seconds) for one OCR
# run, independent of DEFAULT_BATCH_LIMIT. Per-item OCR cost is highly variable
# (confirmed live: ~95-290s/page); this protects the rest of that day's fundamentals
# pipeline (L1/L2/L3/watchlist/notifications all run after this step) from a bad day
# of large documents consuming the entire run. Default 3 hours.
FUNDAMENTALS_OCR_MAX_RUNTIME_SECONDS=10800

# fundamentals/collectors/ocr_pipeline.py -- MAX_RUNTIME_SECONDS above is only
# checked BETWEEN documents; these two bound OCR time WITHIN a single document (a
# single stuck page, or a many-page document, could otherwise consume the entire run's
# budget before the next between-document check ever fired). Defaults generous
# relative to the observed 95-290s/page. See PER_PAGE_OCR_TIMEOUT_SECONDS's comment
# in ocr_pipeline.py for why a timed-out page's worker thread is abandoned, not killed.
# MAX_DOCUMENT_SECONDS default raised 1800 -> 7200 (re-audit 2026-08-18): 1800s was
# tight enough to permanently fail a real, legitimate document -- see
# MAX_DOCUMENT_OCR_SECONDS' own comment in ocr_pipeline.py.
FUNDAMENTALS_OCR_PAGE_TIMEOUT_SECONDS=900
FUNDAMENTALS_OCR_MAX_DOCUMENT_SECONDS=7200

# fundamentals/collectors/ocr_pipeline.py -- caps how many pages of one document get
# rasterized into memory. Over this, ocr_pdf_bytes() switches to a bounded per-page
# render loop and OCRs only the first MAX_OCR_PAGES rather than loading the whole
# document upfront (re-audit 2026-08-18: a 100-page attachment would otherwise
# extrapolate to ~3GB RSS alongside the loaded OCR model). Default comfortably above
# the observed real max (31 pages).
FUNDAMENTALS_OCR_MAX_PAGES=60

# fundamentals/screens/notifications.py -- daily consolidated watchlist digest email
# for the fundamental screener. OFF by default -- turning this on requires
# WATCHLIST_ALERT_EMAIL_FROM to be a SES-verified sender identity (and the AWS
# account out of SES sandbox mode, or every WATCHLIST_ALERT_EMAIL_TO address also
# verified). WATCHLIST_ALERT_EMAIL_TO takes one or more addresses separated by
# spaces, e.g. "a@example.com b@example.com" -- sent as Bcc (WATCHLIST_ALERT_EMAIL_FROM
# is the self-addressed To), so recipients don't see each other's addresses.
WATCHLIST_ALERT_EMAIL_ENABLED=false
WATCHLIST_ALERT_EMAIL_FROM=
WATCHLIST_ALERT_EMAIL_TO=

# all_fundamentals_api.sh -- host/port the fundamentals API (fundamentals/api/app.py)
# binds to and health-checks before (re)starting under cron.
FUNDAMENTALS_API_HOST=127.0.0.1
FUNDAMENTALS_API_PORT=8000

# AWS for storing OCR and other things
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Screener credentials
SCREENER_IN_LOGIN=
SCREENER_IN_PASSWORD=

# Dhan
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_ACCESS_TOKEN=
DHAN_TOKEN_ID=
# If false, Dhan auto-login still runs automatically when CDP_ENDPOINT and the three login vars below are configured.
DHAN_AUTO_LOGIN_ENABLED=false
DHAN_LOGIN_MOBILE=
DHAN_LOGIN_PIN=
DHAN_TOTP_SECRET=
DHAN_DAILY_REFRESH_OVERLAP_DAYS=7
DHAN_INTRADAY_REFRESH_OVERLAP_MINUTES=10
DHAN_API_AUTH_ATTEMPTS=3
DHAN_AUTO_LOGIN_SUBPROCESS_TIMEOUT_SECONDS=180
DHAN_AUTO_LOGIN_STEP_TIMEOUT_MS=30000

# Browser / CDP
CHROME_BINARY=
CDP_ENDPOINT=

# S3 / object store
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
AWS_BUCKET_NAME=stockeydata
BLOB_TEXT_EXCERPT_CHARS=1200
# Daily OHLCV universe reconciliation (start_cron.sh startup step + 18:45 cron entry +
# ./all_ohlcv_reconcile.sh): backfills universe symbols whose latest daily bar predates
# the last completed trading day, so freshness gates never silently suppress buy authority.
OHLCV_RECONCILE_MAX_SYMBOLS=400
# IST hour after which today's EOD bars are expected (lets the 18:45 pre-advisory
# reconcile fetch today's bars before the 19:10 advisory).
OHLCV_RECONCILE_TODAY_COMPLETE_AFTER_HOUR_IST=18
# utils/universe.py's get_equity_universe(): bhavcopy union window (a single
# incomplete/delayed day must not collapse the universe). Shared by any caller that
# needs "the current tradeable NSE universe" -- not reconcile-specific despite the
# old OHLCV_RECONCILE_CONSTITUENTS_LOOKBACK_DAYS name this replaced 2026-08-14.
EQUITY_UNIVERSE_LOOKBACK_DAYS=7
# Sharpely /api/v2/core AES-256-CBC response key (UTF-8, zero-padded to 32 bytes). Recovered
# from the web bundle; override if it rotates (statements endpoint stops decrypting).
SHARPELY_V2_AES_KEY=p10tibarp999sha11lynt
# Data readiness (nightly 22:30 fix pass, and --require gates any caller that wants one):
# hard errors are missing bhavcopy day / Dhan coverage under the floor;
# --fix runs bounded repairs (bhavcopy re-fetch -> OHLCV reconcile).
DATA_READINESS_BHAVCOPY_MIN_ROWS=1500
DATA_READINESS_DHAN_WARN_PCT=90
DATA_READINESS_DHAN_ERROR_PCT=60
DATA_READINESS_DHAN_TODAY_AFTER_HOUR_IST=23
DATA_READINESS_BHAVCOPY_MAX_WARN_LAG_DAYS=1
DATA_READINESS_BYPASS=false
STOCKEY_DIR=
LOG_DIR=logs/cron
STOCKEY_SYMBOLS=
STOCKEY_DISPLAY_TZ=Asia/Kolkata
# In-run retries for a transient empty (0-byte) NSE bhavcopy download before giving up for this run
# (the date stays a candidate on the next run regardless).
NSE_BHAVCOPY_EMPTY_DOWNLOAD_RETRIES=2

# Operator scripts (all optional -- shown defaults are already baked into the scripts)
PYTHON_BIN=
CDP_HOST=127.0.0.1
CDP_PORT=9222
CHROME_USER_DATA_DIR=~/.stockey/chrome-cdp
EXTERNAL_WORKER_MAX_TASKS=50
LOG_ROTATE_KEEP_DAYS=14
LOG_ROTATE_MIN_BYTES=1048576
OHLCV_RECONCILE_ARGS=
STOCKEY_CRON_USER=
GO_CROND_VERSION=
GO_CROND_INSTALL_DIR=
