# Core paths
BASE_DIR=
HTTP_CACHE=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SQL_TO_DF_RETRIES=2
SQL_TO_DF_RETRY_SLEEP_SECONDS=1.0
SQL_TO_DF_STATEMENT_TIMEOUT_MS=0
SQL_TO_DF_CHUNK_SIZE=0
DB_OPERATION_ATTEMPTS=3
DB_POOL_RECYCLE_SECONDS=300
DB_RETRY_TELEMETRY_FILE=logs/fallback/db_retry_events.jsonl
LOCAL_FALLBACK_TELEMETRY_FILE=logs/fallback/local_fallback_events.jsonl

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_OPERATION_ATTEMPTS=3
REDIS_RETRY_SLEEP_SECONDS=1.0
REDIS_RECONNECT_COOLDOWN_SECONDS=30.0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_FAIL_SOFT=true

# NSE historical lookbacks
NSE_BHAVCOPY_DOWNLOAD_LOOKBACK_DAYS=365
NSE_BHAVCOPY_PARSE_LOOKBACK_DAYS=365
NSE_INDICES_DOWNLOAD_LOOKBACK_DAYS=365
NSE_INDICES_PARSE_LOOKBACK_DAYS=365
# Empty (0-byte) NSE index downloads are transient: retry this many extra times in-run, then keep
# retrying across the next N daily runs before giving up (so a transient empty never becomes a permanent gap).
NSE_INDICES_EMPTY_DOWNLOAD_RETRIES=2
NSE_INDICES_EMPTY_RETRY_WINDOW_DAYS=4
NSE_OFFMARKET_DOWNLOAD_LOOKBACK_DAYS=365
NSE_LEGACY_RETENTION_DAYS=365
NSE_LEGACY_ARCHIVE_PREFIX=archives/nseindia
TRACE_RETENTION_DAYS=90
INTRADAY_RETENTION_DAYS=45
HOT_TABLE_ARCHIVE_PREFIX=archives/hot_tables
RBI_FBIL_GSEC_LOOKBACK_DAYS=365

# Codex CLI (used by utils/ocr and utils/transcribe as an optional OCR/transcription
# provider -- NOT part of the data pipeline; stockey's collectors make zero LLM calls,
# see docs/DATA_INVENTORY.md)
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=gpt-5.4-mini
CODEX_CLI_OCR_MODEL=gpt-5.4-mini
CODEX_CLI_TIMEOUT_SECONDS=300
POPPLER_PATH=

# utils/ocr and utils/transcribe standalone utilities (OpenAI/Gemini providers)
OPENAI_API_KEY=
GEMINI_KEY=

# Dhan
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_ACCESS_TOKEN=
DHAN_TOKEN_ID=
# If false, Dhan auto-login still runs automatically when CDP_ENDPOINT and the three login vars below are configured.
DHAN_AUTO_LOGIN_ENABLED=false
DHAN_LOGIN_MOBILE=
DHAN_LOGIN_PIN=
DHAN_TOTP_SECRET=
DHAN_DAILY_REFRESH_OVERLAP_DAYS=7
DHAN_INTRADAY_REFRESH_OVERLAP_MINUTES=10
DHAN_API_AUTH_ATTEMPTS=3
DHAN_AUTO_LOGIN_SUBPROCESS_TIMEOUT_SECONDS=180
DHAN_AUTO_LOGIN_STEP_TIMEOUT_MS=30000

# Browser / CDP
CHROME_BINARY=
CDP_ENDPOINT=

# S3 / object store
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
AWS_BUCKET_NAME=stockeydata
BLOB_TEXT_EXCERPT_CHARS=1200
# Daily OHLCV universe reconciliation (start_cron.sh startup step + 18:45 cron entry +
# ./all_ohlcv_reconcile.sh): backfills universe symbols whose latest daily bar predates
# the last completed trading day, so freshness gates never silently suppress buy authority.
OHLCV_RECONCILE_MAX_SYMBOLS=400
# Constituents union window for the reconcile universe (a partial weekend snapshot must
# not collapse the universe) and the IST hour after which today's EOD bars are expected
# (lets the 18:45 pre-advisory reconcile fetch today's bars before the 19:10 advisory).
OHLCV_RECONCILE_CONSTITUENTS_LOOKBACK_DAYS=7
OHLCV_RECONCILE_TODAY_COMPLETE_AFTER_HOUR_IST=18
# Sharpely /api/v2/core AES-256-CBC response key (UTF-8, zero-padded to 32 bytes). Recovered
# from the web bundle; override if it rotates (statements endpoint stops decrypting).
SHARPELY_V2_AES_KEY=p10tibarp999sha11lynt
# Data readiness (nightly 22:30 fix pass, and --require gates any caller that wants one):
# hard errors are missing bhavcopy day / Dhan coverage under the floor;
# --fix runs bounded repairs (bhavcopy re-fetch -> OHLCV reconcile).
DATA_READINESS_BHAVCOPY_MIN_ROWS=1500
DATA_READINESS_DHAN_WARN_PCT=90
DATA_READINESS_DHAN_ERROR_PCT=60
DATA_READINESS_DHAN_TODAY_AFTER_HOUR_IST=23
DATA_READINESS_BHAVCOPY_MAX_WARN_LAG_DAYS=1
DATA_READINESS_BYPASS=false
STOCKEY_DIR=
LOG_DIR=logs/cron
STOCKEY_SYMBOLS=
STOCKEY_DISPLAY_TZ=Asia/Kolkata
# In-run retries for a transient empty (0-byte) NSE bhavcopy download before giving up for this run
# (the date stays a candidate on the next run regardless).
NSE_BHAVCOPY_EMPTY_DOWNLOAD_RETRIES=2

# Operator scripts (all optional -- shown defaults are already baked into the scripts)
PYTHON_BIN=
CDP_HOST=127.0.0.1
CDP_PORT=9222
CHROME_USER_DATA_DIR=~/.stockey/chrome-cdp
EXTERNAL_WORKER_MAX_TASKS=50
LOG_ROTATE_KEEP_DAYS=14
LOG_ROTATE_MIN_BYTES=1048576
OHLCV_RECONCILE_ARGS=
STOCKEY_CRON_USER=
GO_CROND_VERSION=
GO_CROND_INSTALL_DIR=
