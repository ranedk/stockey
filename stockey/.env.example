ACTION_EVENT_POLICY_REDUCE_EXPOSURE_AS_REVIEW_ACTION=true
ACTION_PLAYBOOK_BUY_WATCH_AS_WATCH=true
ACTION_PLAYBOOK_REDUCE_EXPOSURE_AS_REVIEW_ACTION=true
ACTION_COMPANY_MEMORY_BRIDGE_ENABLED=true
ACTION_COMPANY_MEMORY_LOOKBACK_DAYS=14
ACTION_COMPANY_MEMORY_MIN_CONFIDENCE=0.65
ACTION_COMPANY_MEMORY_MIN_CONVICTION=60
ACTION_CONTEXT_OVERLAY_LOOKBACK_DAYS=30
ACTION_CONTEXT_OVERLAY_MAX_ROWS_PER_SYMBOL=10
ACTION_CAUSAL_EVENT_MEMORY_LOOKBACK_DAYS=30
ACTION_CAUSAL_EVENT_MEMORY_MAX_ROWS_PER_SYMBOL=8
ACTION_SIGNAL_QUALITY_OVERLAY_RULE_CONSUMER_ENABLED=false
# [P-LLM-AUTH] master switch for live LLM->broker trade authority. DEFAULT OFF. The decision
# contract is audit-only until this is on AND the policy passed outcome-monitoring graduation.
LLM_DIRECT_AUTHORITY_ENABLED=false
# Grounding is hierarchical + verdict-based (no magnitude score): non-technical evidence is the
# thesis/filter, technicals are the timing, market context is the regime gate, benchmark-excess
# classifies the mode (alpha vs market-participation) rather than blocking. There are no tunable
# thresholds here -- the rule is structural (see advisory/llm_decision_contract).
# [P-LLM-AUTH].2 deterministic risk bounds (the safety floor): no single LLM call can be catastrophic.
LLM_DECISION_MAX_POSITION_PCT=0.05
LLM_DECISION_MIN_POSITION_PCT=0.01
LLM_DECISION_MAX_SECTOR_EXPOSURE_PCT=0.25
LLM_DECISION_MAX_TOTAL_EXPOSURE_PCT=1.0
LLM_DECISION_STOP_ATR_MULT=2.0
# [P-LLM-AUTH].3 outcome monitoring (systematic-error detector; alerts, never blocks). Judged on
# benchmark-excess after cost; needs enough matured labels before a pattern is trusted.
LLM_DECISION_MONITOR_MIN_MATURED=20
LLM_DECISION_MONITOR_MIN_GROUP_MATURED=8
LLM_DECISION_MONITOR_MIN_EXCESS_HIT_RATE=0.45
LLM_DECISION_MONITOR_MIN_MEAN_EXCESS=0.0
LLM_DECISION_MONITOR_BETA_TILT_RATE=0.50
# [P-LLM-AUTH].4a evidence packet: a hypothesis match needs match_score >= this to count as
# conditions-met (unless its decision_json carries an explicit conditions_met).
LLM_DECISION_HYPOTHESIS_MIN_MATCH_SCORE=0.5
# [P-LLM-AUTH].4b model for the LLM decision policy (review-only proposal graded by .1, sized by .2).
LLM_DECISION_POLICY_MODEL=codex
# Daily review-only decision runner: capital used for sizing and the default universe cap. Review-only
# (broker_execution_allowed stays False); these only size/record decisions, they never trade.
LLM_DECISION_RUNNER_CAPITAL_INR=1000000
LLM_DECISION_RUNNER_UNIVERSE_LIMIT=200
# Daily cron decision cycle (all_llm_decisions.sh): extra args appended to the runner. Defaults to
# --no-llm so cron never makes LLM API calls; set to "" to opt this deployment into the LLM (decisions
# stay review-only regardless). Also: seconds the job waits for the post-close advisory lock to clear.
LLM_DECISION_CRON_ARGS=--no-llm
LLM_DECISIONS_WAIT_FOR_ADVISORY_TIMEOUT_SECONDS=7200
# Realized-outcome labeler (closes the loop): horizon + round-trip cost the .3 monitor judges on,
# and the min matured healthy outcomes required before a policy may graduate (.1/.5 graduation_passed).
LLM_DECISION_OUTCOME_HORIZON_DAYS=20
LLM_DECISION_OUTCOME_COST_BPS=25
LLM_DECISION_GRADUATION_MIN_MATURED=20
WATCHLIST_CONTEXT_OVERLAY_ENABLED=true
WATCHLIST_CONTEXT_OVERLAY_LOOKBACK_DAYS=14
WATCHLIST_CONTEXT_OVERLAY_LIMIT=50
WATCHLIST_CONTEXT_OVERLAY_RELIABILITY_PRIORITY_ENABLED=true
WATCHLIST_CONTEXT_OVERLAY_HELPFUL_SCORE_MULTIPLIER=1.25
WATCHLIST_CONTEXT_OVERLAY_BREAKOUT_SCORE_THRESHOLD=0.75
WATCHLIST_CONTEXT_OVERLAY_BREAKOUT_MAX_AGE_DAYS=7
WATCHLIST_CONTEXT_OVERLAY_BREAKOUT_MIN_ACTIONABILITY=0.40
WATCHLIST_CONTEXT_OVERLAY_NEGATIVE_SUPPRESSION_ENABLED=true
WATCHLIST_CONTEXT_OVERLAY_TECHNICAL_PRIORITY_ENABLED=true
WATCHLIST_CONTEXT_OVERLAY_TECHNICAL_PRIORITY_MAX_BONUS=0.15
WATCHLIST_CONTEXT_OVERLAY_SUPPRESS_HARD_OHLCV_BLOCKERS=true
WATCHLIST_CONTEXT_OVERLAY_OHLCV_ISSUE_EXCLUSION_ATTEMPTS=2
WATCHLIST_CONTEXT_OVERLAY_EXCLUDED_RELIABILITY_CLASSES=hurts_or_no_lift,negative_after_cost,inconsistent_or_horizon_sensitive,needs_benchmark_attribution,benchmark_beta_not_overlay_alpha
ACTION_MARKET_CONTEXT_RISK_OFF_SCORE_THRESHOLD=0.60
ACTION_MARKET_CONTEXT_WEAK_BREADTH_THRESHOLD=40
ACTION_MARKET_CONTEXT_CAUTION_RISK_OFF_SCORE_THRESHOLD=0.45
ACTION_MARKET_CONTEXT_CAUTION_BREADTH_THRESHOLD=50
ACTION_MARKET_CONTEXT_CAUTION_SIZE_MULTIPLIER=0.75
ACTION_MARKET_CONTEXT_REGIME_LABEL_HARD_BLOCK_ENABLED=false
ACTION_MARKET_CONTEXT_WEAK_BREADTH_HARD_BLOCK_ENABLED=false
ACTION_MARKET_CONTEXT_SCORE_RISK_OFF_HARD_BLOCK_ENABLED=false
ACTION_MARKET_CONTEXT_HIGH_MACRO_RISK_HARD_BLOCK_ENABLED=false
ACTION_MARKET_CONTEXT_SYMBOL_LEADERSHIP_OVERRIDE_ENABLED=true
ACTION_MARKET_CONTEXT_LEADER_SOFTENS_SCORE_RISK_OFF_ENABLED=true
ACTION_MARKET_CONTEXT_CONTEXT_OVERLAY_OVERRIDE_ENABLED=true
ACTION_MARKET_CONTEXT_CONTEXT_OVERLAY_SOFTENS_ANY_SYMBOL_ENABLED=true
RULE_ENGINE_REGIME_LABEL_HARD_BLOCK_ENABLED=false
RULE_ENGINE_OVERLAY_LABEL_HARD_BLOCK_ENABLED=false
RULE_ENGINE_REGIME_FIT_WEIGHT_MULTIPLIER=0.35
RULE_ENGINE_REQUIRE_REGIME_CONTEXT=false
TECHNICAL_THRESHOLD_PROMOTION_REVIEW_MODEL=codex
EVENT_POLICY_LLM_MANUAL_REVIEW_ENABLED=true
EVENT_POLICY_LLM_MANUAL_REVIEW_MODEL=codex
EVENT_POLICY_LLM_MANUAL_REVIEW_MAX_ROWS=25
EVENT_POLICY_LLM_MANUAL_REVIEW_TIMEOUT_SECONDS=180
COMPANY_MEMORY_REVIEW_LLM_ENABLED=false
COMPANY_MEMORY_REVIEW_MODEL=gpt-5.4-mini
COMPANY_MEMORY_REVIEW_MAX_SYMBOLS=12
COMPANY_MEMORY_REVIEW_LOOKBACK_DAYS=180
COMPANY_MEMORY_CONTEXT_OVERLAY_LOOKBACK_DAYS=90
COMPANY_MEMORY_CAUSAL_EVENT_MEMORY_LOOKBACK_DAYS=90
REGIME_OVERLAY_LLM_ENABLED=false
REGIME_OVERLAY_MODEL=gpt-5.4-mini
REGIME_OVERLAY_LOOKBACK_DAYS=7
HYPOTHESIS_ACTION_MODEL=codex
HYPOTHESIS_MARKET_CONTEXT_RISK_OFF_SCORE_THRESHOLD=0.60
HYPOTHESIS_MARKET_CONTEXT_REGIME_LABEL_HARD_BLOCK_ENABLED=false
HYPOTHESIS_MARKET_CONTEXT_WEAK_BREADTH_HARD_BLOCK_ENABLED=false
HYPOTHESIS_MARKET_CONTEXT_SCORE_RISK_OFF_HARD_BLOCK_ENABLED=false
HYPOTHESIS_MARKET_CONTEXT_HIGH_MACRO_RISK_HARD_BLOCK_ENABLED=false
HYPOTHESIS_MARKET_CONTEXT_SYMBOL_LEADERSHIP_OVERRIDE_ENABLED=true
HYPOTHESIS_MARKET_CONTEXT_CONTEXT_OVERLAY_OVERRIDE_ENABLED=true
HYPOTHESIS_MARKET_CONTEXT_CONTEXT_OVERLAY_SOFTENS_ANY_SYMBOL_ENABLED=true
HYPOTHESIS_CONTEXT_OVERLAY_LOOKBACK_DAYS=30
HYPOTHESIS_CRON_ARGS=
MANUAL_REVIEW_WAIT_SIGNAL_DAYS=30
OCR_USING=codex
POPPLER_PATH=
TRANSCRIBE_WITH=gemini-3-flash-preview
SUMMARIZE_WITH=codex

