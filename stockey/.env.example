# Core paths
BASE_DIR=
HTTP_CACHE=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SQL_TO_DF_RETRIES=2
SQL_TO_DF_RETRY_SLEEP_SECONDS=1.0
SQL_TO_DF_STATEMENT_TIMEOUT_MS=0
SQL_TO_DF_CHUNK_SIZE=0
DB_OPERATION_ATTEMPTS=3
DB_POOL_RECYCLE_SECONDS=300

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_OPERATION_ATTEMPTS=3
REDIS_RETRY_SLEEP_SECONDS=1.0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_FAIL_SOFT=true

# NSE historical lookbacks
NSE_BHAVCOPY_DOWNLOAD_LOOKBACK_DAYS=365
NSE_BHAVCOPY_PARSE_LOOKBACK_DAYS=365
NSE_INDICES_DOWNLOAD_LOOKBACK_DAYS=365
NSE_INDICES_PARSE_LOOKBACK_DAYS=365
NSE_OFFMARKET_DOWNLOAD_LOOKBACK_DAYS=365
NSE_LEGACY_RETENTION_DAYS=365
NSE_LEGACY_ARCHIVE_PREFIX=archives/nseindia
NSE_HTTP_MAX_ATTEMPTS=0
NSE_HTTP_RETRY_SLEEP_SECONDS=5.0
NSE_HTTP_RETRY_MAX_SLEEP_SECONDS=120.0
EAINDUSTRY_WPI_LOOKBACK_DAYS=365
MOSPI_CPI_LOOKBACK_DAYS=365
FRED_US_MACRO_LOOKBACK_DAYS=365
RBI_FBIL_GSEC_LOOKBACK_DAYS=365
NSDL_FPI_LOOKBACK_DAYS=365

# LLM providers
OPENAI_API_KEY=
GEMINI_KEY=
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=gpt-5.4-mini
CODEX_CLI_OCR_MODEL=gpt-5.4-mini
CODEX_CLI_SUMMARIZE_MODEL=gpt-5.4-mini
CODEX_CLI_EVENT_MODEL=gpt-5.4-mini
CODEX_CLI_TIMEOUT_SECONDS=300
ADVISORY_EVENT_EVAL_MODEL=codex
ACTION_MANUAL_REVISION_POINTERS_ENABLED=false
ACTION_MANUAL_REVISION_POINTERS_MODEL=codex
ACTION_MANUAL_REVISION_POINTERS_TIMEOUT_SECONDS=180
ACTION_MANUAL_REVISION_POINTERS_MAX_CANDIDATES=8
ACTION_MARKET_CONTEXT_RISK_OFF_SCORE_THRESHOLD=0.60
ACTION_MARKET_CONTEXT_WEAK_BREADTH_THRESHOLD=40
ACTION_MARKET_CONTEXT_CAUTION_RISK_OFF_SCORE_THRESHOLD=0.45
ACTION_MARKET_CONTEXT_CAUTION_BREADTH_THRESHOLD=50
ACTION_MARKET_CONTEXT_CAUTION_SIZE_MULTIPLIER=0.75
TECHNICAL_THRESHOLD_PROMOTION_REVIEW_MODEL=codex
EVENT_POLICY_LLM_MANUAL_REVIEW_ENABLED=true
EVENT_POLICY_LLM_MANUAL_REVIEW_MODEL=codex
EVENT_POLICY_LLM_MANUAL_REVIEW_MAX_ROWS=25
EVENT_POLICY_LLM_MANUAL_REVIEW_TIMEOUT_SECONDS=180
HYPOTHESIS_ACTION_MODEL=codex
HYPOTHESIS_CRON_ARGS=
OCR_USING=codex
TRANSCRIBE_WITH=gemini-3-flash-preview
SUMMARIZE_WITH=codex

# Dhan
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_ACCESS_TOKEN=
DHAN_TOKEN_ID=
# If false, Dhan auto-login still runs automatically when CDP_ENDPOINT and the three login vars below are configured.
DHAN_AUTO_LOGIN_ENABLED=false
DHAN_LOGIN_MOBILE=
DHAN_LOGIN_PIN=
DHAN_TOTP_SECRET=
DHAN_DAILY_REFRESH_OVERLAP_DAYS=7
DHAN_INTRADAY_REFRESH_OVERLAP_MINUTES=10
DHAN_API_AUTH_ATTEMPTS=3
STOCKEY_LIVE_TRADING_ENABLED=false
STOCKEY_EXECUTION_MAX_LIVE_ORDERS_PER_RUN=5
STOCKEY_EXECUTION_MAX_ORDER_VALUE_INR=50000
STOCKEY_EXECUTION_REQUIRE_FRESH_INTRADAY_PRICE=true
STOCKEY_EXECUTION_MAX_INTRADAY_PRICE_AGE_MINUTES=30
ADVISORY_INTRADAY_LOOKBACK_DAYS=30
EXECUTION_ALLOW_LEGACY_PORTFOLIO_FALLBACK=false

# Browser / CDP
CHROME_BINARY=
CDP_ENDPOINT=
SCREENER_IN_LOGIN=
SCREENER_IN_PASSWORD=

# S3 / object store
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
AWS_BUCKET_NAME=stockeydata
BLOB_TEXT_EXCERPT_CHARS=1200
ANNOUNCEMENT_POSTGRES_TEXT_MODE=pointer
ANNOUNCEMENT_POSTGRES_TEXT_EXCERPT_CHARS=1200
EVENT_MODEL_ARTIFACT_UPLOAD_ENABLED=true
EVENT_MODEL_ARTIFACT_S3_PREFIX=models/advisory_event_meta_model

# Builder / cron
GO_CROND_VERSION=
GO_CROND_INSTALL_DIR=
TS_FORECAST_MODEL_NAME=timesfm_2p5_200m
TS_FORECAST_MAX_SYMBOLS=80
TS_FORECAST_COST_BPS=25
TS_TIMESFM_CHECKPOINT=google/timesfm-2.5-200m-pytorch
MARKET_CONTEXT_WATCH_LIMIT=50
WATCHER_OHLCV_MAX_LOOKBACK_MINUTES=240
EVENT_POLICY_EVAL_HORIZONS=5 10 20
EVENT_POLICY_EVAL_COST_BPS=25
EVENT_POLICY_EVAL_MIN_MATURED_ROWS=10
TECHNICAL_CALIBRATION_HORIZONS=5 10 20
TECHNICAL_CALIBRATION_COST_BPS=25
TECHNICAL_CALIBRATION_MIN_SIGNALS=10

# Operator frontend
OPERATOR_API_HOST=127.0.0.1
OPERATOR_API_PORT=8765
OPERATOR_API_USE_SNAPSHOT=true
OPERATOR_API_ALLOW_STALE_SNAPSHOT=true
OPERATOR_API_SLOW_REQUEST_MS=750
OPERATOR_API_PAYLOAD_CACHE_SECONDS=15
OPERATOR_API_LARGE_RESPONSE_BYTES=250000
OPERATOR_API_INTRADAY_PRICE_FALLBACK=false

# Advisory performance controls
ADVISORY_PARALLEL_LOCAL_STAGES=1
ADVISORY_LOCAL_STAGE_WORKERS=3
ADVISORY_DISABLE_RULE_REPAIR=1
OPERATOR_SNAPSHOT_MAX_AGE_SECONDS=86400
OPERATOR_SNAPSHOT_SLOW_BUILD_MS=5000
PERFORMANCE_LOG_DIR=logs/performance
SLOW_OPERATION_LOG_FILE=logs/performance/slow_operations.jsonl
SLOW_OPERATION_STATE_FILE=logs/performance/slow_operation_state.json
SLOW_OPERATION_THRESHOLD_MS=1000
API_LATENCY_PROBE_SLOW_MS=750
API_LATENCY_PROBE_TIMEOUT_SECONDS=30
OPERATOR_WEB_HOST=127.0.0.1
OPERATOR_WEB_PORT=3000
OPERATOR_WEB_INSTALL_DEPS=auto
OPERATOR_WEB_USE_NVM=true
OPERATOR_WEB_NVM_VERSION=default
OPERATOR_WEB_NPM_INSTALL_ARGS=
OPERATOR_WEB_NPM_LEGACY_PEER_DEPS=true
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8765

# Shell wrapper overrides
PYTHON_BIN=
WATCHLIST_FILE=
TRACKED_FILE=
TRUNCATE_DERIVED=0
STOCKEY_SYMBOLS=
