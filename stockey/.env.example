# Operator frontend
OPERATOR_API_HOST=127.0.0.1
OPERATOR_API_PORT=8085
OPERATOR_API_BASE_URL=http://127.0.0.1:8085
# CORS: comma-separated origins allowed to call the operator API (the Nuxt web app).
# Update this if the frontend host/port changes.
OPERATOR_WEB_ORIGINS=http://localhost:3035,http://127.0.0.1:3035
OPERATOR_API_USE_SNAPSHOT=true
OPERATOR_API_ALLOW_STALE_SNAPSHOT=true
OPERATOR_API_SLOW_REQUEST_MS=750
OPERATOR_API_PAYLOAD_CACHE_SECONDS=15
OPERATOR_API_LARGE_RESPONSE_BYTES=250000
OPERATOR_API_INTRADAY_PRICE_FALLBACK=false
OPERATOR_API_TRACE_SUMMARY_CACHE_ENABLED=true
OPERATOR_API_ERROR_TRACE_CHARS=4000
OPERATOR_API_HEALTH_TIMEOUT_SECONDS=5
OPERATOR_API_RUNTIME_URL=http://127.0.0.1:8085/api/runtime
OPERATOR_WEB_HEALTH_URL=http://127.0.0.1:3035/
OPERATOR_WEB_HEALTH_TIMEOUT_SECONDS=3
OPERATOR_API_STALE_CODE_GRACE_SECONDS=300
OPERATOR_COMMAND_TIMEOUT_SECONDS=1800
OPERATOR_COMMAND_OUTPUT_TAIL_CHARS=12000
OPERATOR_CURRENT_PRICE_MAX_AGE_SECONDS=86400
OPERATOR_SOURCE_WARNING_MAX_AGE_SECONDS=86400
OPERATOR_HEALTH_FAST_WORKERS=3
OPERATOR_HEALTH_FULL_WORKERS=4
OPERATOR_HEALTH_FULL_PROCESS_ISOLATED=true
OPERATOR_HEALTH_FULL_SECTION_TIMEOUT_SECONDS=30
OPERATOR_HEALTH_COMPACT_LIST_LIMIT=25
OPERATOR_HEALTH_COMPACT_STRING_CHARS=2000
OPERATOR_HEALTH_INGESTION_FAILURE_ACTIVE_DAYS=30
OPERATOR_HEALTH_FEATURE_STAGE_GATES_TIMEOUT_SECONDS=20
OPERATOR_HEALTH_FEATURE_STAGE_GATE_SYMBOL_LIMIT=5
OPERATOR_SMOKE_COMPACT_LIST_LIMIT=8
OPERATOR_SMOKE_COMPACT_STRING_CHARS=1000
FEATURE_STAGE_GATE_SYMBOL_LIMIT=25

# Advisory performance controls
ADVISORY_PARALLEL_LOCAL_STAGES=1
ADVISORY_LOCAL_STAGE_WORKERS=3
ADVISORY_DISABLE_RULE_REPAIR=1
ADVISORY_LOG_PATH=logs/cron/all_advisory.log
ADVISORY_AUTO_LATEST_TRADING_DATE=true
ADVISORY_SKIP_POST_REFRESH=false
ADVISORY_SKIP_PRE_SIGNAL_REFRESH=false
ADVISORY_PRE_SIGNAL_REFRESH_LIMIT=50
ADVISORY_PRE_SIGNAL_REFRESH_FORCE=false
ADVISORY_SKIP_PRE_CONTEXT_WATCHLIST_RECONCILE=false
ADVISORY_PRE_CONTEXT_WATCHLIST_FORCE=false
ADVISORY_PRE_CAUSAL_MEMORY_REFRESH=true
ADVISORY_PRE_CAUSAL_MEMORY_REFRESH_LIMIT=25
ADVISORY_STAGE_BUDGET_SECONDS=900
ADVISORY_STAGE_BUDGET_OVERRIDES=
# Crash-safe resume for all_advisory.sh: ADVISORY_RESUME=1 makes the pipeline skip
# stages already completed for the same advisory date within the recency window below.
# Off by default so the scheduled EOD run always recomputes fresh.
ADVISORY_RESUME=0
ADVISORY_RESUME_MAX_AGE_HOURS=18
# Cap on a single decision-trace payload; larger payloads are truncated to a marker so a
# runaway trace can never approach Postgres's 1 GiB field limit (see decision_trace).
ADVISORY_TRACE_PAYLOAD_MAX_BYTES=4194304
# Daily OHLCV universe reconciliation (start_cron.sh startup step + 18:45 cron entry +
# ./all_ohlcv_reconcile.sh): backfills universe symbols whose latest daily bar predates
# the last completed trading day, so freshness gates never silently suppress buy authority.
OHLCV_RECONCILE_MAX_SYMBOLS=400
OHLCV_RECONCILE_ARGS=
# Constituents union window for the reconcile universe (a partial weekend snapshot must
# not collapse the universe) and the IST hour after which today's EOD bars are expected
# (lets the 18:45 pre-advisory reconcile fetch today's bars before the 19:10 advisory).
OHLCV_RECONCILE_CONSTITUENTS_LOOKBACK_DAYS=7
OHLCV_RECONCILE_TODAY_COMPLETE_AFTER_HOUR_IST=18
# Whole-market action discovery lane (advisory/market_action_scan.py): daily bhavcopy
# breakout scan joins the universe as screener source market-action-scan-v1 with
# junk-ELIMINATING filters only; downstream candidate/technical/risk gates decide quality.
MARKET_ACTION_SCAN_ENABLED=true
MARKET_ACTION_SCAN_LIMIT=30
MARKET_ACTION_SCAN_MIN_PRICE=50
MARKET_ACTION_SCAN_MIN_TURNOVER_INR=50000000
MARKET_ACTION_SCAN_MIN_VOLUME_MULTIPLE=2.0
MARKET_ACTION_SCAN_MIN_BREAKOUT_PCT=1.0
MARKET_ACTION_SCAN_MAX_CIRCUIT_HITS_20D=2
# TS-forecast rescue allow-gate: a technically-unconfirmed candidate with a strong
# TimesFM forecast is rescued to PASS_NOW with the override recorded; risk sizing applies
# TECHNICAL_OVERRIDE_ALLOCATION_FACTOR; the rescued cohort matures through outcome
# labeling so the gate keeps or loses its power on measured benchmark-excess evidence.
TS_FORECAST_RESCUE_ENABLED=true
TS_FORECAST_RESCUE_HORIZON_DAYS=10
TS_FORECAST_RESCUE_MIN_FORECAST_RETURN=0.05
TS_FORECAST_RESCUE_MIN_PROBABILITY=0.65
TS_FORECAST_RESCUE_MIN_SIGNAL_QUALITY=0.65
TS_FORECAST_RESCUE_MAX_DOWNSIDE_P10=-0.12
TS_FORECAST_RESCUE_MAX_PER_DAY=5
TS_FORECAST_RESCUE_MAX_FORECAST_AGE_DAYS=5
TECHNICAL_OVERRIDE_ALLOCATION_FACTOR=0.50
# Operator Health daily-OHLCV coverage thresholds (percent of universe current through
# the last completed trading day): warn below the first, error below the second.
OPERATOR_HEALTH_OHLCV_COVERAGE_WARN_PCT=90
OPERATOR_HEALTH_OHLCV_COVERAGE_ERROR_PCT=60
ADVISORY_SKIP_RECOMMENDATION_DIAGNOSTICS=false
# Daily log rotation (cron 06:50): sizable logs are archived per-day as
# logs/**/archive/<name>.<YYYY-MM-DD>.log.gz (copy-then-truncate) and pruned.
LOG_ROTATE_KEEP_DAYS=14
LOG_ROTATE_MIN_BYTES=1048576
# Watch tiering (operational attention, never authority): active tier gets intraday OHLCV
# sync, priority announcement-ingest slots, and full EOD ingestion; shelf rides daily bars
# and ingests at most every SHELF_INGEST_MAX_AGE_DAYS. Active = near trigger, held, RS >=
# WATCH_TIER_RS_MIN, or event-hot; capped at ACTIVE_TIER_MAX (overflow demoted visibly).
WATCH_TIER_RS_MIN=80
ACTIVE_TIER_MAX=60
SHELF_INGEST_MAX_AGE_DAYS=2
# Watch retention (enter fast, exit slow): recently-admitted screener members are retained
# for a per-source window (admission-anchored, so retained rows never self-extend); lapsed
# members get a recorded exit in advisory_watch_exits, enrolled in the regret ledger as
# watch_exit:<slug> so the windows are tuned by measured forward excess.
SCREENER_RETENTION_DAYS_DEFAULT=5
SCREENER_RETENTION_DAYS_SCAN=10
# Theme screeners: active positive news themes admit their sector universe as constituents
# source theme-<id> (sector-alias join to the top-context universe); YAML decay
# max_active_days is enforced (stale themes stop emitting). Lowest-conviction lane, capped.
THEME_SCREENERS_ENABLED=true
THEME_SCREENER_MAX_SYMBOLS=25
THEME_SCREENER_DEFAULT_MAX_ACTIVE_DAYS=21
# Hypothesis screeners: each active hypothesis materializes its universe (operator-set
# target_universe_json, else matched symbols) as constituents source hypothesis-<id>;
# paused/retired hypotheses stop emitting and their symbols age out of watch.
HYPOTHESIS_SCREENERS_ENABLED=true
HYPOTHESIS_SCREENER_MAX_SYMBOLS=50
# Cross-sectional relative strength (the selection layer for the max-positions slots):
# daily full-market percentiles from bhavcopy; computed in the all_ohlcv_reconcile slot.
# Missing RS is always neutral for consumers.
RS_RANK_MIN_HISTORY_ROWS=64
RS_RANK_MIN_TURNOVER_INR=10000000
RS_RANK_WEIGHT_63D=0.4
RS_RANK_WEIGHT_126D=0.3
RS_RANK_WEIGHT_252D=0.2
RS_RANK_WEIGHT_HIGH_PROXIMITY=0.1
RS_PRIORITY_WEIGHT=1.0
SKIP_RELATIVE_STRENGTH=false
# Regime admission policy: 3-state (risk_on/neutral/risk_off) top-of-funnel width control
# with hysteresis; neutral reproduces the previous hardcoded admission tolerances exactly.
# Entry confirmation and risk gates never flex. Per-state parameter overrides also exist as
# REGIME_ADMISSION_<RISK_ON|NEUTRAL|RISK_OFF>_<SCAN_LIMIT|MCAP_BELOW_TOLERANCE|
# MCAP_ABOVE_TOLERANCE|LIQUIDITY_FLOOR_MULTIPLIER>.
REGIME_ADMISSION_CONFIRM_DAYS=3
REGIME_ADMISSION_UPTREND_RET20=0.03
REGIME_ADMISSION_UPTREND_RET60=0.06
REGIME_ADMISSION_DOWNTREND_RET20=-0.03
REGIME_ADMISSION_DOWNTREND_RET60=-0.06
REGIME_ADMISSION_RISK_ON_MIN_BREADTH_PCT=55
# Automatic regret ledger (post-advisory, non-fatal): enrolls every gate-blocked
# would-be BUY and matures 5/10/20d forward benchmark-excess so each gate carries a
# measurable P&L (surfaced on the Scorecard as gate_regret).
ADVISORY_SKIP_REGRET_LEDGER=false
REGRET_LEDGER_COST_BPS=25
REGRET_LEDGER_BENCHMARK_TICKER=NIFTY
ADVISORY_DHAN_PREFLIGHT=true
ADVISORY_DHAN_PREFLIGHT_AUTO_LOGIN=true
ADVISORY_DHAN_PREFLIGHT_MIN_FRESH_MINUTES=30
ADVISORY_DHAN_PREFLIGHT_SKIP_VALIDATE=false
CONTEXT_REPAIR_AUTO_LATEST_TRADING_DATE=true
CONTEXT_REPAIR_SIGNAL_REFRESH_LIMIT=50
CONTEXT_REPAIR_SIGNAL_REFRESH_FORCE=false
CONTEXT_REPAIR_WATCHLIST_FORCE=false
CONTEXT_REPAIR_SKIP_SIGNAL_REFRESH=false
CONTEXT_REPAIR_SKIP_WATCHLIST_RECONCILE=false
CONTEXT_REPAIR_SKIP_TECHNICAL_REFRESH=false
CONTEXT_REPAIR_SKIP_BOUNDED_ADVISORY=false
CONTEXT_REPAIR_SKIP_ACTION_REFRESH=false
CONTEXT_REPAIR_SKIP_DIAGNOSTICS=false
CONTEXT_REPAIR_PARALLEL_LOCAL_STAGES=true
CONTEXT_REPAIR_LOCAL_STAGE_WORKERS=3
CONTEXT_REPAIR_WAIT_FOR_DATA_TIMEOUT_SECONDS=7200
RESEARCH_EVIDENCE_INCLUDE_SPLIT_REPORTS=true
RESEARCH_EVIDENCE_EXTRA_ARGS=
RESEARCH_EVIDENCE_LOG_MAX_BYTES=2000000
ACTION_RECOMMENDER_PROGRESS_LOG_ENABLED=true
ACTION_RECOMMENDER_ENSURE_CONTEXT_INDEXES=true
ACTION_RECOMMENDER_PERSIST_LIVE_FEATURE_FRESHNESS_ENABLED=false
ACTION_RECOMMENDER_PERSIST_TRACE_ENABLED=true
ACTION_RECOMMENDER_CLI_TRACE_ENABLED=false
ACTION_TRANSITION_STABILITY_POLICY_GATE_ENABLED=true
ACTION_SIGNAL_REFRESH_LOOKBACK_DAYS=3
ACTION_SIGNAL_REFRESH_MAX_ROWS=500
WATCHER_ACTION_REFRESH_ENABLED=true
WATCHER_ACTION_REFRESH_MAX_SYMBOLS=50
WATCHER_CAUSAL_MEMORY_REFRESH_ENABLED=true
WATCHER_CAUSAL_MEMORY_REFRESH_LIMIT=25
OPERATOR_SNAPSHOT_MAX_AGE_SECONDS=86400
OPERATOR_SNAPSHOT_SLOW_BUILD_MS=5000
PERFORMANCE_LOG_DIR=logs/performance
SLOW_OPERATION_LOG_FILE=logs/performance/slow_operations.jsonl
SLOW_OPERATION_STATE_FILE=logs/performance/slow_operation_state.json
SLOW_OPERATION_THRESHOLD_MS=1000
API_LATENCY_PROBE_SLOW_MS=750
API_LATENCY_PROBE_TIMEOUT_SECONDS=30
API_LATENCY_PROBE_OUTPUT_FILE=logs/performance/latest_api_latency_probe.json
API_LATENCY_PROBE_MAX_AGE_SECONDS=86400
SIGNAL_QUALITY_MAX_AGE_DAYS=30
SIGNAL_QUALITY_MIN_MATURED_ROWS=10
SIGNAL_QUALITY_MIN_OVERLAY_ROWS=10
SIGNAL_QUALITY_PROMOTION_FDR_ALPHA=0.10
SIGNAL_QUALITY_PROMOTION_SECTOR_CONCENTRATION_NOTE_THRESHOLD=0.60
SUPERSEDED_CLEANUP_AUDIT_LIMIT=500
OPERATOR_WEB_HOST=127.0.0.1
OPERATOR_WEB_PORT=3035
OPERATOR_FRONTEND_COMPONENT=both
OPERATOR_WEB_INSTALL_DEPS=auto
OPERATOR_WEB_USE_NVM=true
OPERATOR_WEB_NVM_VERSION=default
OPERATOR_WEB_NPM_INSTALL_ARGS=
OPERATOR_WEB_NPM_LEGACY_PEER_DEPS=true
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8085
NUXT_PUBLIC_API_TIMEOUT_MS=12000
OPERATOR_FRONTEND_HEALTH_INTERVAL_SECONDS=30
OPERATOR_FRONTEND_HEALTH_FAILURE_LIMIT=3
OPERATOR_FRONTEND_HEALTH_STARTUP_GRACE_SECONDS=45
OPERATOR_FRONTEND_HEALTH_TIMEOUT_SECONDS=5
OPERATOR_FRONTEND_RESTART_ON_CODE_CHANGE=true
OPERATOR_FRONTEND_CODE_CHECK_SECONDS=60

# Shell wrapper overrides
PYTHON_BIN=
VIRTUAL_ENV=
STOCKEY_DIR=
STOCKEY_CRON_USER=
LOG_DIR=logs/cron
OPERATOR_CRON_LOG_DIR=logs/cron
WATCHLIST_FILE=
TRACKED_FILE=
TRUNCATE_DERIVED=0
STOCKEY_SYMBOLS=
STOCKEY_DISPLAY_TZ=Asia/Kolkata
STOCKEY_SKIP_TIMESFM_INSTALL=false
