{
  "version": 1,
  "tools": [
    {
      "name": "sql_query",
      "category": "storage",
      "description": "Run a SQL query and return JSON.",
      "command": ["python", "scripts/sql_query_runner.py"],
      "read_only": false,
      "examples": [
        {
          "args": ["--read-only", "select * from macro_usa order by date desc limit 5"],
          "description": "Read recent macro rows"
        }
      ]
    },
    {
      "name": "redis_scan",
      "category": "storage",
      "description": "Scan Redis keys and return JSON.",
      "command": ["python", "scripts/redis_query_runner.py", "scan"],
      "read_only": true,
      "examples": [
        {
          "args": ["--pattern", "nse:*"],
          "description": "Inspect NSE-related keys"
        }
      ]
    },
    {
      "name": "redis_get",
      "category": "storage",
      "description": "Read one Redis key and return JSON.",
      "command": ["python", "scripts/redis_query_runner.py", "get"],
      "read_only": true,
      "examples": [
        {
          "args": ["bhav:parsed", "--max-items", "20"],
          "description": "Inspect one parsed-set key"
        }
      ]
    },
    {
      "name": "s3_list",
      "category": "storage",
      "description": "List S3 objects or prefixes as JSON.",
      "command": ["python", "scripts/s3_query_runner.py", "list"],
      "read_only": true,
      "examples": [
        {
          "args": ["--prefix", "bhavcopy/", "--delimiter", "/"],
          "description": "List bhavcopy prefixes"
        }
      ]
    },
    {
      "name": "s3_head",
      "category": "storage",
      "description": "Fetch S3 object metadata as JSON.",
      "command": ["python", "scripts/s3_query_runner.py", "head"],
      "read_only": true,
      "examples": [
        {
          "args": ["--key", "bhavcopy/example.zip"],
          "description": "Read S3 object metadata"
        }
      ]
    },
    {
      "name": "load_us_macro",
      "category": "ingestion",
      "description": "Run the FRED and ISM macro loaders.",
