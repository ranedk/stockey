SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/{{STOCKEY_USER}}/.local/bin
CRON_TZ=Asia/Kolkata
MAILTO=""

STOCKEY_DIR={{STOCKEY_DIR}}
LOG_DIR={{LOG_DIR}}

# Create log directory once before enabling the crontab:
#   mkdir -p {{LOG_DIR}}
#
# Install with:
#   crontab {{GENERATED_CRONTAB}}
#
# Or run with go-crond:
#   ./go-crond {{GENERATED_CRONTAB}} --allow-unprivileged

# Daily raw download + parse refresh before market open on weekdays.
10 07 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && /usr/bin/flock -n /tmp/stockey_complete_data.lock ./complete_data.sh >> "$LOG_DIR/complete_data.log" 2>&1

# Portfolio/advisory run a few times a week after the raw refresh has completed.
20 08 * * 1,3,5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && /usr/bin/flock -n /tmp/stockey_advisory.lock ./all_advisory.sh >> "$LOG_DIR/all_advisory.log" 2>&1

# Continuous one-shot watch during market hours on weekdays.
# Internal sync state keeps news/announcements slower while OHLCV stays more frequent.
*/10 09-15 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && /usr/bin/flock -n /tmp/stockey_watchers.lock ./all_watchers.sh >> "$LOG_DIR/all_watchers.log" 2>&1

# Static dashboard refresh every 15 minutes on weekdays so portfolio/advisory state is visible
# even outside watcher-triggered rewrites.
*/15 08-18 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && /usr/bin/flock -n /tmp/stockey_dashboard_refresh.lock "$("$STOCKEY_DIR/scripts/resolve_python.sh")" -m advisory.live_dashboard --output-dir live_dashboard >> "$LOG_DIR/live_dashboard.log" 2>&1

# One final post-close watch pass for end-of-day alerts and dashboard refresh.
05 16 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && /usr/bin/flock -n /tmp/stockey_watchers.lock ./all_watchers.sh >> "$LOG_DIR/all_watchers.log" 2>&1

# Event-model prep and training once daily after market close.
45 18 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && /usr/bin/flock -n /tmp/stockey_ml.lock ./all_ml.sh >> "$LOG_DIR/all_ml.log" 2>&1

# Optional split refreshes if you want explicit control instead of complete_data.sh.
# 05 07 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && /usr/bin/flock -n /tmp/stockey_downloaders.lock ./all_downloaders.sh >> "$LOG_DIR/all_downloaders.log" 2>&1
# 40 07 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && /usr/bin/flock -n /tmp/stockey_parsers.lock ./all_parsers.sh >> "$LOG_DIR/all_parsers.log" 2>&1
# @reboot {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && /usr/bin/flock -n /tmp/stockey_dashboard_http.lock "$("$STOCKEY_DIR/scripts/resolve_python.sh")" -m http.server --directory live_dashboard 8000 >> "$LOG_DIR/live_dashboard_http.log" 2>&1
