SHELL=/bin/bash
PATH=/opt/homebrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/{{STOCKEY_USER}}/.local/bin
CRON_TZ=Asia/Kolkata
MAILTO=""

STOCKEY_DIR={{STOCKEY_DIR}}
LOG_DIR={{LOG_DIR}}

# Create log directory once before enabling the crontab:
#   mkdir -p {{LOG_DIR}}
#
# Run with go-crond:
#   ./go-crond {{GENERATED_CRONTAB}} --allow-unprivileged
#
# This file includes a username field. Remove that field before installing into a normal per-user crontab.

# ---------------------------------------------------------------------------
# Recurring cron-managed jobs.
# ---------------------------------------------------------------------------

# Daily broad raw download + parse safety net before market open on weekdays.
# A second end-of-day complete_data.sh run below repairs anything intraday jobs missed before advisory.
10 07 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_complete_data.lock ./complete_data.sh >> "$LOG_DIR/complete_data.log" 2>&1

# Queue single-client downloader work and drain it without parallel NSE/Dhan/Screener sessions.
# The direct complete_data.sh path remains the broad catch-up/backfill safety net.
30 08,12,16 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_download_queue.lock ./all_downloaders_queue.sh >> "$LOG_DIR/all_downloaders_queue.log" 2>&1
35 08,12,16 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_external_workers.lock ./all_external_workers.sh >> "$LOG_DIR/external_workers.log" 2>&1

# End-of-day broad catch-up before advisory. This intentionally runs the full
# download+parse path so missed downloader/parser work is repaired before
# portfolio/action reconciliation.
30 17 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_complete_data.lock ./complete_data.sh >> "$LOG_DIR/complete_data_eod.log" 2>&1

# Advisory readiness preflight before the expensive post-close reconciliation.
# This validates/refreshes Dhan auth and runs compact operator smoke, but does
# not run the advisory pipeline or submit broker orders.
55 18 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_advisory_preflight.lock ./all_advisory_preflight.sh >> "$LOG_DIR/all_advisory_preflight.log" 2>&1

# Portfolio/advisory run daily after market close. Wait for end-of-day data
# catch-up and queued single-client workers before reconciling actions.
10 19 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && { "$STOCKEY_DIR/scripts/wait_for_locks.sh" --timeout-seconds "${ADVISORY_WAIT_FOR_DATA_TIMEOUT_SECONDS:-7200}" /tmp/stockey_complete_data.lock /tmp/stockey_download_queue.lock /tmp/stockey_external_workers.lock && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_advisory.lock ./all_advisory.sh; } >> "$LOG_DIR/all_advisory.log" 2>&1

# Continuous one-shot watch during market hours on weekdays.
# Internal sync state keeps news/announcements slower while OHLCV stays more frequent.
*/10 09-15 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && ./all_watchers.sh >> "$LOG_DIR/all_watchers.log" 2>&1

# Operator frontend supervisor. Runs API + Nuxt and restarts within 5 minutes if it exits.
# Static live_dashboard generation is disabled.
*/5 * * * * {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_frontend.lock ./all_frontend.sh >> "$LOG_DIR/operator_frontend.log" 2>&1

# Operator API latency probe. Writes latest latency summary under logs/performance and records slow endpoints.
55 07,11,16,21 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" logs/performance && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_api_latency_probe.lock ./all_api_latency_probe.sh >> "$LOG_DIR/api_latency_probe.log" 2>&1

# Operator health snapshot. This writes current failures/fix hints into logs and exercises DB/API/snapshot/cron visibility.
# Dhan validation is skipped here to avoid triggering broker auth from cron; cached-token freshness is still checked.
05 08,12,17,22 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_operator_health.lock ./all_operator_health.sh >> "$LOG_DIR/operator_health.log" 2>&1

# Superseded failure cleanup audit. Preview-only; apply mode is intentionally not scheduled.
35 17 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_superseded_cleanup_audit.lock ./all_superseded_cleanup_audit.sh >> "$LOG_DIR/superseded_cleanup_audit.log" 2>&1

# One final post-close watch pass for end-of-day alerts.
05 16 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && ./all_watchers.sh >> "$LOG_DIR/all_watchers.log" 2>&1

# Investor hypothesis/playbook scan over newly collected news and announcements.
# Set HYPOTHESIS_CRON_ARGS="--no-llm" if you want deterministic scans only.
25 10,13,16,21 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_hypothesis_scan.lock ./all_hypothesis_scan.sh >> "$LOG_DIR/hypothesis_scan.log" 2>&1

# Experimental TS forecast workflow. This uses config/ts_forecast_screeners.yaml
# to select a liquid technical universe, refreshes Dhan daily OHLCV, and writes research-only TS watch rows.
# Daily OHLCV changes slowly, so this runs a few times a day instead of every watcher tick.
20 11,14,17,20 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_ts_forecast.lock ./all_ts_forecast_workflow.sh >> "$LOG_DIR/ts_forecast_workflow.log" 2>&1

# Matured TS forecast evaluation. This validates prior forecast rows after costs; it does not create actions.
20 18,21 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_ts_forecast_eval.lock ./all_ts_forecast_evaluator.sh >> "$LOG_DIR/ts_forecast_evaluator.log" 2>&1

# Research-only TS forecast paper portfolio. Compares forecast-only decisions with naive momentum and advisory alignment.
35 21 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_ts_forecast_paper.lock ./all_ts_forecast_paper_portfolio.sh >> "$LOG_DIR/ts_forecast_paper_portfolio.log" 2>&1

# Research-only event-policy realized-return evaluation. Runs after the post-close advisory window.
# It writes policy/action/class quality summaries only; it does not change thresholds or actions.
10 23 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_event_policy_eval.lock ./all_event_policy_evaluator.sh >> "$LOG_DIR/event_policy_evaluator.log" 2>&1

# Weekly research-only technical threshold calibration. This is deliberately not tied to live promotion.
# Review the operator UI before manually changing config/advisory_setups.yaml.
20 04 * * 6 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_technical_calibration.lock ./all_technical_threshold_calibration.sh >> "$LOG_DIR/technical_threshold_calibration.log" 2>&1

# Weekly long-running research-only event-model prep/training.
# It refreshes event-model evidence but does not change live policy automatically.
10 03 * * 0 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_ml.lock ./all_ml.sh >> "$LOG_DIR/all_ml.log" 2>&1

# ---------------------------------------------------------------------------
# Manual / catch-up / long-running scripts. Keep these commented unless you
# intentionally want extra end-of-day repair jobs.
# ---------------------------------------------------------------------------
#
# Optional split refreshes if you want explicit control instead of complete_data.sh.
# 05 07 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_downloaders.lock ./all_downloaders.sh >> "$LOG_DIR/all_downloaders.log" 2>&1
# 40 07 * * 1-5 {{STOCKEY_USER}} cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_parsers.lock ./all_parsers.sh >> "$LOG_DIR/all_parsers.log" 2>&1
