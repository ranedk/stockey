SHELL=/bin/bash
PATH=/opt/homebrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/rane/.local/bin
CRON_TZ=Asia/Kolkata
MAILTO=""

STOCKEY_DIR=/Users/rane/code/stockey
LOG_DIR=/Users/rane/code/stockey/logs/cron

# Create log directory once before enabling the crontab:
#   mkdir -p /Users/rane/code/stockey/logs/cron
#
# Run with go-crond:
#   ./go-crond /Users/rane/code/stockey/config/stockey.generated.crontab --allow-unprivileged
#
# This file includes a username field. Remove that field before installing into a normal per-user crontab.

# ---------------------------------------------------------------------------
# Recurring cron-managed jobs.
# ---------------------------------------------------------------------------

# Late-night data catch-up: Dhan publishes EOD bars staggered (only a fraction of the
# universe has them at the 18:45 reconcile), and a bad morning bhavcopy fetch must not
# survive the night. Checks bhavcopy/Dhan coverage/RS and runs bounded fixes.
30 22 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_data_readiness.lock ./all_data_readiness.sh >> "$LOG_DIR/data_readiness.log" 2>&1

# Daily log rotation before the morning jobs: archive sizable logs as
# logs/cron/archive/<name>.<YYYY-MM-DD>.log.gz (copy-then-truncate so long-running
# processes keep their handles) and prune archives past LOG_ROTATE_KEEP_DAYS.
50 06 * * * rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_log_rotate.lock "$STOCKEY_DIR/scripts/rotate_logs.sh" >> "$LOG_DIR/rotate_logs.log" 2>&1

# Daily broad raw download + parse safety net before market open on weekdays.
# A second end-of-day complete_data.sh run below repairs anything intraday jobs missed before advisory.
10 07 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_complete_data.lock ./complete_data.sh >> "$LOG_DIR/complete_data.log" 2>&1

# Queue single-client downloader work and drain it without parallel NSE/Dhan/Screener sessions.
# The direct complete_data.sh path remains the broad catch-up/backfill safety net.
30 08,12,16 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_download_queue.lock ./all_downloaders_queue.sh >> "$LOG_DIR/all_downloaders_queue.log" 2>&1
35 08,12,16 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_external_workers.lock ./all_external_workers.sh >> "$LOG_DIR/external_workers.log" 2>&1

# End-of-day broad catch-up before advisory. This intentionally runs the full
# download+parse path so missed downloader/parser work is repaired before
# portfolio/action reconciliation.
30 17 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_complete_data.lock ./complete_data.sh >> "$LOG_DIR/complete_data_eod.log" 2>&1

# Daily OHLCV coverage reconciliation before the advisory chain. Backfills any
# universe symbol whose latest daily bar predates the last completed trading day
# (e.g. after the scheduler was down during market hours), so freshness gates
# never suppress buy authority because of silently stale bars. start_cron.sh
# also runs this once at scheduler startup.
45 18 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_ohlcv_reconcile.lock ./all_ohlcv_reconcile.sh >> "$LOG_DIR/ohlcv_reconcile.log" 2>&1

# Advisory readiness preflight before the expensive post-close reconciliation.
# This validates/refreshes Dhan auth and runs compact operator smoke, but does
# not run the advisory pipeline or submit broker orders.
55 18 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_advisory_preflight.lock ./all_advisory_preflight.sh >> "$LOG_DIR/all_advisory_preflight.log" 2>&1

# Bounded context-to-entry repair before the expensive full advisory run.
# This refreshes review-only context signals, reconciles CONTEXT_OVERLAY_WATCH,
# and runs rules-through-actions only, so positive context is not blocked by
# stale watch rows before post-close advisory.
00 19 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && { "$STOCKEY_DIR/scripts/wait_for_locks.sh" --timeout-seconds "${CONTEXT_REPAIR_WAIT_FOR_DATA_TIMEOUT_SECONDS:-7200}" /tmp/stockey_complete_data.lock /tmp/stockey_download_queue.lock /tmp/stockey_external_workers.lock && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_context_to_entry_repair.lock ./all_context_to_entry_repair.sh; } >> "$LOG_DIR/context_to_entry_repair.log" 2>&1

# Portfolio/advisory run daily after market close. Wait for end-of-day data
# catch-up, queued single-client workers, and bounded context repair before
# reconciling actions.
10 19 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && { "$STOCKEY_DIR/scripts/wait_for_locks.sh" --timeout-seconds "${ADVISORY_WAIT_FOR_DATA_TIMEOUT_SECONDS:-7200}" /tmp/stockey_complete_data.lock /tmp/stockey_download_queue.lock /tmp/stockey_external_workers.lock /tmp/stockey_context_to_entry_repair.lock && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_advisory.lock ./all_advisory.sh; } >> "$LOG_DIR/all_advisory.log" 2>&1

# Daily review-only LLM decision cycle. After the post-close advisory run finishes (waits for its
# lock), generate a graded/sized decision per symbol over the active universe, persist them to
# advisory_llm_decisions, and mature any elapsed-horizon outcomes into advisory_llm_decision_outcomes
# for the systematic-error monitor. Deterministic by default (no LLM API calls); set
# LLM_DECISION_CRON_ARGS="" to opt a deployment into the LLM. Never moves capital (broker_execution_allowed=false).
00 22 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && { "$STOCKEY_DIR/scripts/wait_for_locks.sh" --timeout-seconds "${LLM_DECISIONS_WAIT_FOR_ADVISORY_TIMEOUT_SECONDS:-7200}" /tmp/stockey_advisory.lock && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_llm_decisions.lock ./all_llm_decisions.sh; } >> "$LOG_DIR/llm_decisions.log" 2>&1

# Continuous one-shot watch during market hours on weekdays.
# Internal sync state keeps news/announcements slower while OHLCV stays more frequent.
*/10 09-15 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && ./all_watchers.sh >> "$LOG_DIR/all_watchers.log" 2>&1

# Operator frontend supervisor. Runs API + Nuxt and restarts within 5 minutes if it exits.
# Static live_dashboard generation is disabled.
*/5 * * * * rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_frontend.lock ./all_frontend.sh >> "$LOG_DIR/operator_frontend.log" 2>&1

# Operator API latency probe. Writes latest latency summary under logs/performance and records slow endpoints.
55 07,11,16,21 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" logs/performance && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_api_latency_probe.lock ./all_api_latency_probe.sh >> "$LOG_DIR/api_latency_probe.log" 2>&1

# Operator health snapshot. This writes current failures/fix hints into logs and exercises DB/API/snapshot/cron visibility.
# Dhan validation is skipped here to avoid triggering broker auth from cron; cached-token freshness is still checked.
05 08,12,17,22 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_operator_health.lock ./all_operator_health.sh >> "$LOG_DIR/operator_health.log" 2>&1

# Superseded failure cleanup audit. Preview-only; apply mode is intentionally not scheduled.
35 17 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_superseded_cleanup_audit.lock ./all_superseded_cleanup_audit.sh >> "$LOG_DIR/superseded_cleanup_audit.log" 2>&1

# One final post-close watch pass for end-of-day alerts.
05 16 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && ./all_watchers.sh >> "$LOG_DIR/all_watchers.log" 2>&1

# Investor hypothesis/playbook scan over newly collected news and announcements.
# Set HYPOTHESIS_CRON_ARGS="--no-llm" if you want deterministic scans only.
25 10,13,16,21 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_hypothesis_scan.lock ./all_hypothesis_scan.sh >> "$LOG_DIR/hypothesis_scan.log" 2>&1

# Experimental TS forecast workflow. This uses config/ts_forecast_screeners.yaml
# to select a liquid technical universe, refreshes Dhan daily OHLCV, and writes research-only TS watch rows.
# Daily OHLCV changes slowly, so this runs a few times a day instead of every watcher tick.
20 11,14,17,20 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_ts_forecast.lock ./all_ts_forecast_workflow.sh >> "$LOG_DIR/ts_forecast_workflow.log" 2>&1

# Matured TS forecast evaluation. This validates prior forecast rows after costs; it does not create actions.
20 18,21 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_ts_forecast_eval.lock ./all_ts_forecast_evaluator.sh >> "$LOG_DIR/ts_forecast_evaluator.log" 2>&1

# Research-only TS forecast paper portfolio. Compares forecast-only decisions with naive momentum and advisory alignment.
35 21 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_ts_forecast_paper.lock ./all_ts_forecast_paper_portfolio.sh >> "$LOG_DIR/ts_forecast_paper_portfolio.log" 2>&1

# Research-only split/bonus-adjusted price table (price-step derived; the paper loop reads adj_close from it).
38 21 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_price_adjustment.lock ./all_price_adjustment.sh >> "$LOG_DIR/price_adjustment.log" 2>&1

# Research-only coherent paper decision loop. RS-selected, vol-sized, crash-floored decisions committed
# and scored forward vs NIFTY. Bypasses the funnel; writes advisory_paper_decision_loop only, no action/broker.
40 21 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_paper_decision_loop.lock ./all_paper_decision_loop.sh >> "$LOG_DIR/paper_decision_loop.log" 2>&1

# Research-only evidence refresh. This matures context/event/action-transition
# evidence daily without running event-model prep/training/scoring and without
# changing policy, portfolio rows, config, or broker behavior.
20 22 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_research_evidence.lock ./all_research_evidence.sh >> "$LOG_DIR/research_evidence.log" 2>&1

# Research-only event-policy realized-return evaluation. Runs after the post-close advisory window.
# It writes policy/action/class quality summaries only; it does not change thresholds or actions.
10 23 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_event_policy_eval.lock ./all_event_policy_evaluator.sh >> "$LOG_DIR/event_policy_evaluator.log" 2>&1

# Research-only missed-movers analyser. Classifies the day's big movers by their funnel
# relationship (no_signal / blocked_by_gate / watched_not_triggered / captured) to guide
# signal development. Writes advisory_missed_movers_daily only; never trades or changes config.
20 23 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_missed_movers.lock ./all_missed_movers.sh >> "$LOG_DIR/missed_movers.log" 2>&1

# Weekly research-only technical threshold calibration. This is deliberately not tied to live promotion.
# Review the operator UI before manually changing config/advisory_setups.yaml.
20 04 * * 6 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_technical_calibration.lock ./all_technical_threshold_calibration.sh >> "$LOG_DIR/technical_threshold_calibration.log" 2>&1

# Weekly long-running research-only event-model prep/training.
# It refreshes event-model evidence plus stable multi-window signal-quality evidence, but does not change live policy automatically.
10 03 * * 0 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_ml.lock ./all_ml.sh --run-signal-quality-window-runner --include-signal-quality-split-reports >> "$LOG_DIR/all_ml.log" 2>&1

# ---------------------------------------------------------------------------
# Manual / catch-up / long-running scripts. Keep these commented unless you
# intentionally want extra end-of-day repair jobs.
# ---------------------------------------------------------------------------
#
# Optional split refreshes if you want explicit control instead of complete_data.sh.
# 05 07 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_downloaders.lock ./all_downloaders.sh >> "$LOG_DIR/all_downloaders.log" 2>&1
# 40 07 * * 1-5 rane cd "$STOCKEY_DIR" && mkdir -p "$LOG_DIR" && "$STOCKEY_DIR/scripts/with_lock.sh" /tmp/stockey_parsers.lock ./all_parsers.sh >> "$LOG_DIR/all_parsers.log" 2>&1
