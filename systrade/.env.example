# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# === Local systrade database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=systrade
POSTGRES_USER=systrade
POSTGRES_PASSWORD=

# === Source: stockey database (sync origin) ===
STOCKEY_PG_HOST=
STOCKEY_PG_PORT=5432
STOCKEY_PG_DB=stockey
STOCKEY_PG_USER=
STOCKEY_PG_PASSWORD=
STOCKEY_PG_FALLBACK_HOST=localhost

# === Dhan broker ===
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_TOTP_SECRET=
DHAN_LOGIN_PIN=
DHAN_LOGIN_MOBILE=
# Path to the access-token cache written by stockey's automated login
DHAN_TOKEN_CACHE=
DHAN_BASE_URL=https://api.dhan.co/v2
STOCKEY_DIR=

# Chrome DevTools Protocol endpoint used by stockey's Dhan web login
CDP_ENDPOINT=http://localhost:9222
CHROME_BINARY=/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome

# === Trading ===
TRADING_CAPITAL=
VOL_TARGET_PCT=0.20
LIVE_ORDERS=no
