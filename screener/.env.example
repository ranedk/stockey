# Base URL of stockey's fundamentals API (fundamentals/api/app.py). Defaults to
# http://localhost:8000 in nuxt.config.ts if unset -- only needed to override.
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Base URL of systrader's own API (systrade/cmd/api) -- a separate backend, not
# proxied through stockey's. Defaults to http://localhost:8090 if unset.
NUXT_PUBLIC_SYSTRADER_API_BASE=http://localhost:8090
